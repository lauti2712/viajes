rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // Único que puede listar todos los viajes (admin.html).
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'lautarom87@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Formas de pago de cada cuenta (tarjetas, cuentas): solo las ve y edita su dueño.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Config global de la app. reloadToken: al cambiarlo (admin.html) todas las apps abiertas se recargan.
    match /meta/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Amigos: cada amistad es un libro que leen y escriben solo sus miembros (a = quien lo creó; b = la
    // cuenta del amigo, cuando acepta el link de invitación de un solo uso: claim == inv).
    match /ledgers/{lid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.a == request.auth.uid
        && request.resource.data.members == [request.auth.uid] && request.resource.data.b == '';
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.members
          && request.resource.data.a == resource.data.a && request.resource.data.b == resource.data.b
          && request.resource.data.members == resource.data.members)
        || (resource.data.b == '' && resource.data.inv != '' && request.auth.uid != resource.data.a
          && request.resource.data.claim == resource.data.inv && request.resource.data.inv == ''
          && request.resource.data.b == request.auth.uid && request.resource.data.a == resource.data.a
          && request.resource.data.members == [resource.data.a, request.auth.uid]));
      allow delete: if signedIn() && resource.data.a == request.auth.uid && resource.data.b == '';
      match /entries/{eid} {
        function inLedger() {
          return signedIn() && request.auth.uid in get(/databases/$(database)/documents/ledgers/$(lid)).data.members;
        }
        allow read: if inLedger();
        allow create, update: if inLedger() && request.resource.data.by == request.auth.uid;
      }
    }

    match /trips/{tripId} {
      function tripPath() {
        return /databases/$(database)/documents/trips/$(tripId);
      }
      // Miembro: entró al viaje con el link (trips/{id}/members/{uid}). Solo los miembros ven y editan el viaje.
      function isMember() {
        return signedIn() && exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
      }
      // Organizador: la cuenta guardada en trip.owner. Puede sacar gente y cerrar el link.
      function isOwner() {
        return signedIn() && exists(tripPath()) && get(tripPath()).data.get('owner', '') == request.auth.uid;
      }
      function same(field, def) {
        return request.resource.data.get(field, def) == resource.data.get(field, def);
      }

      // Listar todos los viajes queda solo para el admin (admin.html).
      allow get: if isMember() || isAdmin();
      allow list: if isAdmin();
      allow create: if isMember() && request.resource.data.get('owner', request.auth.uid) == request.auth.uid;
      // owner se fija una sola vez (el que armó el viaje) y locked solo lo cambia el organizador.
      allow update: if isMember()
        && (same('owner', '') || (resource.data.get('owner', '') == '' && request.resource.data.owner == request.auth.uid))
        && (same('locked', false) || isOwner());

      // Entrar con el link: cada uno se anota a sí mismo, salvo que el organizador lo haya sacado
      // o haya cerrado el viaje a gente nueva. Salir: uno mismo o el organizador.
      match /members/{userId} {
        allow read: if isMember() || isAdmin();
        allow create: if signedIn() && userId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && !exists(/databases/$(database)/documents/trips/$(tripId)/banned/$(userId))
          && (!exists(tripPath()) || get(tripPath()).data.get('locked', false) != true);
        allow update: if signedIn() && userId == request.auth.uid && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && (userId == request.auth.uid || isOwner());
      }
      // Cuentas que el organizador sacó del viaje: no pueden volver a entrar con el link.
      match /banned/{userId} {
        allow read: if isMember() || isAdmin();
        allow create, delete: if isOwner() && userId != request.auth.uid;
      }

      function claimPath(personId) {
        return /databases/$(database)/documents/trips/$(tripId)/claims/$(personId);
      }
      // La persona `personId` del viaje está vinculada a la cuenta que hace el pedido.
      function owns(personId) {
        return personId is string && personId != ''
          && exists(claimPath(personId))
          && get(claimPath(personId)).data.uid == request.auth.uid;
      }

      // Transportes, alojamiento, gastos, planes y personas: compartidos entre los miembros.
      // No hay delete: la app borra marcando del:true (así queda en la papelera).
      match /items/{itemId} {
        allow read: if isMember() || isAdmin();
        allow create, update: if isMember();
      }
      // Historial de cambios: se agrega, nunca se edita ni se borra.
      match /log/{logId} {
        allow read: if isMember() || isAdmin();
        allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      }

      // Gastos propios ("Para mí" pagados por uno): solo los ve y edita la cuenta dueña (ouid).
      match /private/{itemId} {
        allow read, delete: if signedIn() && resource.data.ouid == request.auth.uid;
        allow create: if isMember() && request.resource.data.ouid == request.auth.uid;
        allow update: if isMember() && resource.data.ouid == request.auth.uid && request.resource.data.ouid == request.auth.uid;
      }

      // Vínculo persona del viaje -> cuenta de Google. Cada persona la puede tomar una sola cuenta.
      // El organizador puede soltar el vínculo de alguien que sacó del viaje.
      match /claims/{personId} {
        allow read: if isMember() || isAdmin();
        allow create: if isMember() && request.resource.data.uid == request.auth.uid;
        allow update: if isMember() && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOwner());
      }

      // Mochila: cada lista la lee y edita solo su dueño. Los demás pueden crear sugerencias
      // (suggested == '1' y from == su propia persona), pero no leerlas después.
      match /packing/{itemId} {
        allow read: if signedIn() && owns(resource.data.owner);
        allow create: if isMember() && (
          owns(request.resource.data.owner)
          || (request.resource.data.get('suggested', '') == '1' && owns(request.resource.data.get('from', '')))
        );
        allow update: if isMember() && owns(resource.data.owner)
          && request.resource.data.owner == resource.data.owner;
      }
    }
  }
}
